{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "tsx server.ts",
    "start:socketio": "tsx server.ts",
    "start:supabase": "SOCKET_BACKEND=supabase tsx server.ts",
    "start:partyserver": "wrangler dev --config ../wrangler.jsonc --local",
    "build:partyserver": "pnpm run typecheck && wrangler deploy --config ../wrangler.jsonc --dry-run --outdir ../.wrangler/build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:model": "vitest run model",
    "test:systems": "vitest run model/rooms/systems",
    "test:roles": "vitest run model/roles",
    "build": "pnpm run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "deploy:partyserver": "wrangler deploy --config ../wrangler.jsonc",
    "test:worker": "node --test worker-tests/*.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "axios": "^1.19.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "neverthrow": "^8.2.0",
    "partyserver": "^0.5.10",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "@mernmafia/db": "workspace:*",
    "@trpc/server": "^11.10.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "@vitest/coverage-v8": "4.1.7",
    "eslint": "^9.39.2",
    "eslint-plugin-neverthrow": "^1.1.4",
    "superjson": "^2.2.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "wrangler": "^4.151.3",
    "zod": "^4.3.6"
  }
}
