{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "tsx server.ts",
    "start:socketio": "tsx server.ts",
    "start:supabase": "SOCKET_BACKEND=supabase tsx server.ts",
    "start:partyserver": "wrangler dev --config ../wrangler.jsonc --local",
    "build:partyserver": "pnpm run typecheck && wrangler deploy --config ../wrangler.jsonc --dry-run --outdir ../.wrangler/build",
    "test": "vitest run",
    "balance:check": "tsx scripts/check-role-balance.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:model": "vitest run model",
    "test:systems": "vitest run model/rooms/systems",
    "test:roles": "vitest run model/roles",
    "build": "pnpm run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "deploy:partyserver": "wrangler deploy --config ../wrangler.jsonc",
    "test:worker": "node --test worker-tests/*.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "axios": "^1.21.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "neverthrow": "^8.2.0",
    "partyserver": "^0.5.10",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "@mernmafia/db": "workspace:*",
    "@trpc/server": "^11.10.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9.39.5",
    "eslint-plugin-neverthrow": "^1.1.4",
    "superjson": "^2.2.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.153.0",
    "zod": "^4.6.7"
  }
}
