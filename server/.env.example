# Server Environment Variables
# Copy this file to .env and fill in the values

# ─── Server Config ─────────────────────────────────────────────────────────

# Port for the HTTP/Socket.IO server (default: 8000)
PORT=8000

# Room size (number of players per game, default: 13)
ROOM_SIZE=13

# Enable debug mode: captcha verification is skipped and extra logging is enabled
DEBUG=false

# ─── ReCaptcha ──────────────────────────────────────────────────────────────

# Google ReCaptcha v3 secret key (required in production)
CAPTCHA_KEY=

# ─── Database ───────────────────────────────────────────────────────────────

# Turso/libSQL database URL
# Local dev: http://localhost:8080 (or the Turso dev URL from `turso dev`)
# Production: libsql://<db>.turso.io
DATABASE_URL=

# Turso authentication token (not required for local dev)
# DATABASE_AUTH_TOKEN=
