# Server Environment Variables
# Copy this file to .env and fill in the values

# ─── Server Config ─────────────────────────────────────────────────────────

# Port for the HTTP/Socket.IO server (default: 8000)
PORT=8000

# Room size (number of players per game, default: 13)
ROOM_SIZE=13

# Enable debug mode: captcha verification is skipped and extra logging is enabled
DEBUG=false

# ─── ReCaptcha ──────────────────────────────────────────────────────────────

# Google ReCaptcha v3 secret key (required in production)
CAPTCHA_KEY=

# ─── Match History API ───────────────────────────────────────────────────────

# URL of the Next.js app (used to POST match history after each game)
# Local dev: http://localhost:3000
# Production: https://<your-domain>
NEXTJS_URL=http://localhost:3000

# Shared secret for authenticating requests to /api/match-history
# Must match BACKEND_SECRET in the Next.js app
# Generate with: openssl rand -hex 32
BACKEND_SECRET=
