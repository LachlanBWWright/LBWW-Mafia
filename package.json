{
  "name": "lbww-mafia-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "bash dev.sh",
    "dev:local": "bash scripts/dev-local.sh",
    "test:manual": "pnpm run dev",
    "dev:down": "docker compose down",
    "metrics:ts": "bash scripts/ts-file-metrics.sh --top=100",
    "test:gameplay:ts": "pnpm --dir server run test",
    "dev:partyserver": "pnpm --dir server run start:partyserver",
    "ai-bots": "node tools/ai-bots/cli.mjs",
    "ai-bots:evaluate": "node tools/ai-bots/evaluation/run.mjs",
    "ai-bots:connect": "node tools/ai-bots/cli.mjs connect",
    "test:e2e": "pnpm --dir nextjs run test:e2e",
    "test:e2e:ui": "bash scripts/playwright-ui.sh",
    "test:e2e:cross-browser": "pnpm --dir nextjs run test:e2e:cross-browser",
    "test:all": "bash scripts/test-all.sh",
    "build:game-server": "pnpm --dir server run build:partyserver",
    "test:gameplay:parity": "pnpm --dir server run test shared/communication/protocol.parity.test.ts server/model/rooms/room.fixture-parity.test.ts",
    "test:gameplay:all": "bash scripts/test-game-logic.sh",
    "test:coverage": "bash scripts/test-coverage.sh",
    "lint": "pnpm run lint:server && pnpm run lint:nextjs && pnpm run lint:mobile",
    "lint:server": "pnpm --dir server run lint",
    "lint:nextjs": "pnpm --dir nextjs run lint",
    "lint:mobile": "pnpm --dir mobile run lint",
    "lint:fix": "pnpm run lint:fix:server && pnpm run lint:fix:nextjs && pnpm run lint:fix:mobile",
    "lint:fix:server": "pnpm --dir server run lint:fix",
    "lint:fix:nextjs": "pnpm --dir nextjs run lint:fix",
    "lint:fix:mobile": "pnpm --dir mobile run lint:fix",
    "storybook": "pnpm --dir nextjs run storybook",
    "storybook:build": "pnpm --dir nextjs run storybook:build",
    "storybook:screenshots": "pnpm run storybook:screenshots:web && pnpm run storybook:screenshots:mobile",
    "storybook:screenshots:web": "pnpm --dir nextjs run storybook:screenshots",
    "storybook:screenshots:mobile": "pnpm --dir mobile run storybook:screenshots",
    "storybook:mobile": "pnpm --dir mobile run storybook",
    "screenshots:mobile": "pnpm --dir mobile run visual:screenshots",
    "test:integration": "pnpm --dir nextjs run test:integration",
    "test:chatgpt": "node --test tools/ai-bots/chatgpt/*.test.mjs",
    "desktop": "node desktop/launch.mjs",
    "desktop:pack": "electron-builder --config desktop/electron-builder.json --dir",
    "desktop:dist": "node desktop/preflight.mjs && electron-builder --config desktop/electron-builder.json",
    "test:desktop": "node --test desktop/*.test.mjs",
    "test:unit": "pnpm run test:chatgpt && pnpm run test:desktop && pnpm --dir server run test && pnpm --dir nextjs run test && pnpm --dir mobile run test",
    "test:chatgpt:coverage": "node --test --experimental-test-coverage --test-coverage-lines=99 --test-coverage-branches=90 --test-coverage-functions=99 --test-coverage-include='desktop/controller.mjs' --test-coverage-include='desktop/protectedStore.mjs' --test-coverage-include='shared/ai/*.mjs' desktop/*.test.mjs tools/ai-bots/chatgpt/*.test.mjs",
    "test:chatgpt:native:coverage": "pnpm --dir server exec vitest run --config ../mobile/vitest.chatgpt.config.ts --coverage",
    "deploy:partyserver": "pnpm --dir server run deploy:partyserver",
    "test:worker": "pnpm --dir server run test:worker"
  },
  "description": "LBWW Mafia monorepo root",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.0.4"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
