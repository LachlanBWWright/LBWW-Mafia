# Mobile (Expo) Environment Variables
# Copy this file to .env and fill in the values

# ─── Real-Time Communication ─────────────────────────────────────────────────

# Socket backend selection: 'partyserver' (default), 'socketio', or 'supabase'
EXPO_PUBLIC_SOCKET_BACKEND=partyserver

# URL for the backend server.
# Socket.IO (local dev): http://localhost:8000
# PartyServer   (local dev): http://localhost:1999
# PartyServer   (deployed):  https://<worker>.<account-subdomain>.workers.dev
# Supabase   (project):   https://<project>.supabase.co
EXPO_PUBLIC_SOCKET_URL=http://localhost:1999

# PartyServer room ID (only used when EXPO_PUBLIC_SOCKET_BACKEND=partyserver)
EXPO_PUBLIC_PARTYSERVER_ROOM=default

# Supabase anon/public key (required when EXPO_PUBLIC_SOCKET_BACKEND=supabase)
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public website origin for shared lobby links and trusted app-link routing.
# Defaults to the origin of EXPO_PUBLIC_TRPC_URL.
# EXPO_PUBLIC_WEBSITE_URL=https://mafia.example.com
