# Mobile (Expo) Environment Variables
# Copy this file to .env and fill in the values

# ─── Real-Time Communication ─────────────────────────────────────────────────

# Socket backend selection: 'socketio' (default), 'partykit', or 'supabase'
EXPO_PUBLIC_SOCKET_BACKEND=socketio

# URL for the backend server.
# Socket.IO (local dev): http://localhost:8000
# PartyKit   (local dev): http://localhost:1999
# PartyKit   (deployed):  https://<project>.partykit.dev
# Supabase   (project):   https://<project>.supabase.co
EXPO_PUBLIC_SOCKET_URL=http://localhost:8000

# PartyKit room ID (only used when EXPO_PUBLIC_SOCKET_BACKEND=partykit)
EXPO_PUBLIC_PARTYKIT_ROOM=default

# Supabase anon/public key (required when EXPO_PUBLIC_SOCKET_BACKEND=supabase)
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ─── Captcha ─────────────────────────────────────────────────────────────────

# ReCaptcha token for the playerJoinRoom call.
# Set to 'dev-bypass-token' for local development (auto-applied when NODE_ENV=development).
# EXPO_PUBLIC_CAPTCHA_TOKEN=
