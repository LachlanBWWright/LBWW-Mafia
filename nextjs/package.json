{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "build": "next build",
    "test": "vitest run",
    "test:e2e": "playwright test -c playwright.config.ts",
    "test:e2e:cross-browser": "playwright test -c playwright.cross-browser.config.ts",
    "check": "eslint . && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "next build && next start",
    "start": "next start",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:screenshots": "STORYBOOK_PORT=${STORYBOOK_PORT:-6006}; export STORYBOOK_PORT STORYBOOK_BASE_URL=http://127.0.0.1:$STORYBOOK_PORT; pnpm run storybook:build && start-server-and-test \"http-server storybook-static -p $STORYBOOK_PORT -c-1\" \"http://127.0.0.1:$STORYBOOK_PORT\" \"playwright test -c .storybook/playwright.config.ts && node ../scripts/check-storybook-screenshot-coverage.mjs storybook-static/index.json .storybook/screenshots.spec.ts-snapshots small-phone phone tablet desktop small-phone-light phone-light tablet-light desktop-light phone-rtl desktop-rtl\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@mernmafia/db": "workspace:*",
    "@mernmafia/shared": "workspace:*",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@trpc/client": "^11.10.0",
    "@trpc/server": "^11.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.564.0",
    "neverthrow": "^8.2.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io-client": "^4.8.4",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@next/env": "16.4.3",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.4",
    "@storybook/addon-docs": "^10.6.4",
    "@storybook/nextjs-vite": "^10.6.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "~19.2.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-drizzle": "^0.2.3",
    "eslint-plugin-neverthrow": "^1.1.4",
    "http-server": "^14.1.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "start-server-and-test": "^3.0.13",
    "storybook": "^10.6.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "ct3aMetadata": {
    "initVersion": "7.39.3"
  }
}
