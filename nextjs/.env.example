# Next.js Environment Variables
# Copy this file to .env.local and fill in the values

# Next Auth
# You can generate a new secret on the command line with:
# npx auth secret
# https://next-auth.js.org/configuration/options#secret
AUTH_SECRET=""

# Next Auth Google Provider
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Drizzle Database
# Local dev (docker-compose): postgresql://postgres:postgres@localhost:5432/mernmafia
# Vercel/Neon supplies DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED (direct).
# Keep both pointed at the same database/branch. Requests use the pooled URL;
# migrations and message notifications automatically use the direct URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mernmafia"
# DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"
# Optional session-capable override for message notifications:
# DIRECT_MESSAGES_DATABASE_URL=

# Node Environment (optional, defaults to development)
# NODE_ENV="development"

# ─── Real-Time Communication ─────────────────────────────────────────────────

# Socket backend selection: 'partyserver' (default), 'socketio', or 'supabase'
NEXT_PUBLIC_SOCKET_BACKEND=partyserver

# URL for the backend server.
# Socket.IO (local dev): http://localhost:8000
# PartyServer   (local dev): http://localhost:1999
# PartyServer   (deployed):  https://<worker>.<account-subdomain>.workers.dev
# Supabase   (project):   https://<project>.supabase.co
NEXT_PUBLIC_SOCKET_URL=http://localhost:1999

# Supabase anon/public key (required when NEXT_PUBLIC_SOCKET_BACKEND=supabase)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Match History API ────────────────────────────────────────────────────────

# Shared secret used by the game server (Socket.IO / PartyServer) to authenticate
# requests to the /api/match-history endpoint. Generate with: openssl rand -hex 32
BACKEND_SECRET=""
