# Next.js Environment Variables
# Copy this file to .env.local and fill in the values

# Next Auth
# You can generate a new secret on the command line with:
# npx auth secret
# https://next-auth.js.org/configuration/options#secret
AUTH_SECRET=""

# Next Auth Google Provider
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Drizzle Database
# Local dev (docker-compose): postgresql://postgres:postgres@localhost:5432/mernmafia
# Supabase (production): get the connection string from your Supabase project settings
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mernmafia"

# Node Environment (optional, defaults to development)
# NODE_ENV="development"

# ─── Real-Time Communication ─────────────────────────────────────────────────

# Socket backend selection: 'socketio' (default), 'partykit', or 'supabase'
NEXT_PUBLIC_SOCKET_BACKEND=socketio

# URL for the backend server.
# Socket.IO (local dev): http://localhost:8000
# PartyKit   (local dev): http://localhost:1999
# PartyKit   (deployed):  https://<project>.partykit.dev
# Supabase   (project):   https://<project>.supabase.co
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000

# Supabase anon/public key (required when NEXT_PUBLIC_SOCKET_BACKEND=supabase)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ReCaptcha site key (required for production; 'dev-bypass-token' is auto-used in development)
# NEXT_PUBLIC_CAPTCHA_TOKEN=

# ─── Match History API ────────────────────────────────────────────────────────

# Shared secret used by the game server (Socket.IO / PartyKit) to authenticate
# requests to the /api/match-history endpoint. Generate with: openssl rand -hex 32
BACKEND_SECRET=""
